{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "_comment": "Hello People design tokens. Platform-agnostic source; mirrors tokens.css primitives. Feed to Style Dictionary / Tokens Studio to generate iOS, Android, Tailwind, Figma variables.",
  "color": {
    "brand": {
      "blue":    { "value": "#1F5CE6", "comment": "Link Blue — primary, trust/intelligence" },
      "violet":  { "value": "#7B3FD0", "comment": "Bridge Violet — human meets machine" },
      "magenta": { "value": "#E62E80", "comment": "People Magenta — warmth, humanity" }
    },
    "neutral": {
      "950": { "value": "#0C0D12" },
      "900": { "value": "#14161D" },
      "800": { "value": "#1B1E27" },
      "700": { "value": "#2A2E39" },
      "600": { "value": "#3A3E4B" },
      "500": { "value": "#565B6A" },
      "400": { "value": "#6B6F7D" },
      "300": { "value": "#9195A3" },
      "200": { "value": "#C9CCD5" },
      "100": { "value": "#E6E7EE" },
      "50":  { "value": "#F4F4F8" },
      "25":  { "value": "#FAFAFC" },
      "0":   { "value": "#FFFFFF" }
    },
    "feedback": {
      "success": { "value": "#12A150" },
      "warning": { "value": "#C77700" },
      "danger":  { "value": "#E5484D" },
      "info":    { "value": "#1F5CE6" }
    }
  },
  "gradient": {
    "signature": {
      "value": "linear-gradient(120deg, #1F5CE6 0%, #7B3FD0 52%, #E62E80 100%)",
      "stops": ["#1F5CE6", "#7B3FD0", "#E62E80"],
      "comment": "The one brand gradient. Use as accent (~10% of any surface), never as a full-page background."
    }
  },
  "typography": {
    "family": {
      "display": { "value": "Poppins" },
      "body":    { "value": "Inter" },
      "mono":    { "value": "JetBrains Mono" }
    },
    "size": {
      "xs":   { "value": "0.75rem" },
      "sm":   { "value": "0.875rem" },
      "base": { "value": "1rem" },
      "md":   { "value": "1.125rem" },
      "lg":   { "value": "1.25rem" },
      "xl":   { "value": "1.5rem" },
      "2xl":  { "value": "1.875rem" },
      "3xl":  { "value": "2.25rem" },
      "4xl":  { "value": "3rem" },
      "5xl":  { "value": "3.75rem" },
      "6xl":  { "value": "4.5rem" }
    },
    "weight": {
      "regular":  { "value": "400" },
      "medium":   { "value": "500" },
      "semibold": { "value": "600" },
      "bold":     { "value": "700" },
      "extra":    { "value": "800" }
    },
    "leading": {
      "tight":   { "value": "1.12" },
      "snug":    { "value": "1.25" },
      "normal":  { "value": "1.55" },
      "relaxed": { "value": "1.7" }
    }
  },
  "space": {
    "1": { "value": "0.25rem" }, "2": { "value": "0.5rem" }, "3": { "value": "0.75rem" },
    "4": { "value": "1rem" }, "5": { "value": "1.5rem" }, "6": { "value": "2rem" },
    "7": { "value": "2.5rem" }, "8": { "value": "3rem" }, "9": { "value": "4rem" },
    "10": { "value": "5rem" }, "11": { "value": "6rem" }, "12": { "value": "8rem" }
  },
  "radius": {
    "xs": { "value": "6px" }, "sm": { "value": "10px" }, "md": { "value": "14px" },
    "lg": { "value": "20px" }, "xl": { "value": "28px" }, "pill": { "value": "999px" }
  },
  "shadow": {
    "sm":    { "value": "0 1px 2px rgba(20,22,34,.05), 0 1px 3px rgba(20,22,34,.05)" },
    "md":    { "value": "0 2px 6px rgba(20,22,34,.06), 0 8px 24px rgba(20,22,34,.07)" },
    "lg":    { "value": "0 4px 12px rgba(20,22,34,.08), 0 24px 56px rgba(20,22,34,.10)" },
    "brand": { "value": "0 6px 18px rgba(31,92,230,.18), 0 18px 48px rgba(230,46,128,.14)" }
  },
  "motion": {
    "ease":       { "value": "cubic-bezier(.2,.7,.3,1)" },
    "duration-1": { "value": "120ms" },
    "duration-2": { "value": "200ms" },
    "duration-3": { "value": "320ms" }
  }
}
